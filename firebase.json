{
  "hosting": [
    {
      "target": "endly",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "**",
          "destination": "https://grassroot.digital/api-client",
          "type": 301
        }
      ],
      "headers": [
        {
          "source": "**/*.@(html|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000, immutable"
            }
          ]
        }
      ]
    },
    {
      "target": "landing",
      "public": "landing-dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/api-client",
          "destination": "/api-client/index.html"
        },
        {
          "source": "/api-client/**",
          "destination": "/api-client/index.html"
        },
        {
          "source": "/jwt-decoder",
          "destination": "/jwt-decoder/index.html"
        },
        {
          "source": "/jwt-decoder/**",
          "destination": "/jwt-decoder/index.html"
        },
        {
          "source": "/json-diff",
          "destination": "/json-diff/index.html"
        },
        {
          "source": "/json-diff/**",
          "destination": "/json-diff/index.html"
        },
        {
          "source": "/regex-tester",
          "destination": "/regex-tester/index.html"
        },
        {
          "source": "/regex-tester/**",
          "destination": "/regex-tester/index.html"
        },
        {
          "source": "/hash-generator",
          "destination": "/hash-generator/index.html"
        },
        {
          "source": "/hash-generator/**",
          "destination": "/hash-generator/index.html"
        },
        {
          "source": "/image-to-pdf",
          "destination": "/image-to-pdf/index.html"
        },
        {
          "source": "/image-to-pdf/**",
          "destination": "/image-to-pdf/index.html"
        },
        {
          "source": "/passport-photo-maker",
          "destination": "/passport-photo-maker/index.html"
        },
        {
          "source": "/passport-photo-maker/**",
          "destination": "/passport-photo-maker/index.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "cleanUrls": true,
      "trailingSlash": false,
      "headers": [
        {
          "source": "**/*.@(html|json)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000, immutable"
            }
          ]
        }
      ]
    },
