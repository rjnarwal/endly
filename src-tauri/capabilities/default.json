{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Endly",
  "windows": ["main", "*"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:event:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "*://*/*" },
        { "url": "*://*" },
        { "url": "http://*/*" },
        { "url": "https://*/*" },
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    },
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "*://*/*" },
        { "url": "*://*" },
        { "url": "http://*/*" },
        { "url": "https://*/*" },
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    },
    {
      "identifier": "http:allow-fetch-send",
      "allow": [
        { "url": "*://*/*" },
        { "url": "*://*" },
        { "url": "http://*/*" },
        { "url": "https://*/*" },
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    },
    "http:allow-fetch-cancel"
  ]
}
